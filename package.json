{
  "name": "usermanagement",
  "version": "0.1.0",
  "private": true,
  "description": "User management monorepo: Hono API on Cloudflare Workers, Neon Postgres, Better Auth, React front end",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @usermanagement/api --filter @usermanagement/web dev",
    "dev:api": "pnpm --filter @usermanagement/api dev",
    "dev:web": "pnpm --filter @usermanagement/web dev",
    "build": "pnpm --filter @usermanagement/web build && pnpm --filter @usermanagement/api build",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm --filter @usermanagement/api deploy",
    "db:generate": "pnpm --filter @usermanagement/db db:generate",
    "db:migrate": "pnpm --filter @usermanagement/db db:migrate",
    "db:push": "pnpm --filter @usermanagement/db db:push",
    "db:studio": "pnpm --filter @usermanagement/db db:studio",
    "seed:admin": "pnpm --filter @usermanagement/db seed:admin"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
