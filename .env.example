# ---------------------------------------------------------------------------
# Root .env  — used by Drizzle Kit (pnpm db:*) and any Node-side tooling.
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Neon Postgres connection string.
# Neon console -> your project -> "Connect" -> copy the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth signing secret (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin the app is served from.
#   local:  http://localhost:8787
#   prod:   https://usermanagement.<your-subdomain>.workers.dev  (or your custom domain)
BETTER_AUTH_URL="http://localhost:8787"

# Comma-separated extra origins allowed to call the API with cookies (Vite dev server).
TRUSTED_ORIGINS="http://localhost:5173"

# First app admin, created by `pnpm seed:admin` (public sign-up is disabled).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="App Admin"
